{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Code Analyzer",
  "version": "0.1.0",
  "identifier": "dev.oazab.cc-analyzer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Code Analyzer",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Analyze local Claude Code usage",
    "longDescription": "Offline analyzer for Claude Code JSONL logs — cost, utilization, recommendations.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzMzM5QjQ0NEE3QzE0NDAKUldSQUZIeEtSSnN6azY4ZEpvOXlUQVFFbjM2YTNhcWd6ejBkS1JqRk1OVGtDU3FWakhTL2xwNTEK",
      "endpoints": [
        "https://github.com/gosamab/cc-analyzer/releases/latest/download/latest.json"
      ]
    }
  }
}
